# ==========================================
# MULTI-PROVIDER LLM ADAPTER CONFIGURATION
# ==========================================

# Provider hỗ trợ: gemini, openai, mock. Offline là mặc định an toàn để học.
LLM_PROVIDER=mock

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
# Bỏ trống để adapter chọn model mặc định tương ứng provider.
LLM_MODEL=

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here
# LLM_MODEL=gpt-4o-mini

# MCP của bài lab là lớp mô phỏng trong cùng process; không cần host/port.
